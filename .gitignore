# Build çıktıları
build/
dist/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Ortam dosyalari (sahte-ornek haric hepsi dislanir)
.env
**/.env*
!.env.example
*.bak
*.orig
*.tmp
*.maint_lock
data/active_db.json
data/maintenance.json
data/snapshot_*.json
data/*_v2.db
data/test_*.db

# Uygulama verisi (yerelde üretilir, depoya girmez)
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/settings.json
!data/settings.example.json
data/notifications.jsonl

# Test artigi (kosucu sentetik gecici dizinde uretir; duserde kalmasin)
tests/*.db
tests/*.db-wal
tests/*.db-shm
tests/*.db-journal
tests/*.maint_lock

# Ekran görüntüleri ve geçici dosyalar
ss*.png
assets/_*.png
assets/_*.txt
*.log

# PyInstaller spec (her build'de mutlak yollarla yeniden üretilir; build.py esastır)
*.spec
