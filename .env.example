# Ornek ortam degiskenleri — SAHTE degerler icerir, gercek anahtar YAZMAYIN.
# NOT: Uygulama `.env` dosyasi OKUMAZ; asagidakiler gercek ORTAM
# degiskeni olarak tanimlanmalidir (Windows, oturumluk):
#   set DEPREM_TELEGRAM_TOKEN=kendi-tokeniniz
# Kalici kullanim icin uygulama ici Ayarlar ekranini kullanin
# (degerler data/settings.json'da yerelde saklanir, depoya girmez).
DEPREM_TELEGRAM_TOKEN=ORNEK-BURAYA-KENDI-TOKENINIZI-YAZIN
DEPREM_TELEGRAM_CHAT_ID=ORNEK-BURAYA-KENDI-CHAT-IDNIZI-YAZIN
